  "components": [
    {
      "name": "Widget surface",
      "kind": "card",
      "refersTo": "widget",
      "description": "Matte floating surface; transparent desktop corners.",
      "html": "<div class=\"ds-widget\">Codex Usage</div>",
      "css": ".ds-widget{background:#141619;color:#F6F6F7;border:1px solid #353940;border-radius:26px;padding:19px;font:600 21px \"Segoe UI Variable\",\"Segoe UI\",sans-serif;}"
    },
    {
      "name": "Icon button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "Refresh action with hover, pressed and lime keyboard focus.",
      "html": "<button class=\"ds-icon\" aria-label=\"Refresh limits\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M15 7A6 6 0 0 0 4 5M4 1v4h4M3 11a6 6 0 0 0 11 2M14 17v-4h-4\"/></svg></button>",
      "css": ".ds-icon{width:30px;height:30px;background:transparent;color:#ABB0BA;border:1px solid transparent;border-radius:7px;display:inline-grid;place-items:center;cursor:pointer}.ds-icon:hover{background:#282B31;color:#FFFFFF}.ds-icon:active{background:#353942}.ds-icon:focus-visible{border-color:#9BEF29;outline:none}.ds-icon:disabled{opacity:.35}"
    },
    {
      "name": "Action button",
      "kind": "button",
      "refersTo": "action-button",
      "description": "Settings save or cancel action.",
      "html": "<button class=\"ds-action\">Save</button>",
      "css": ".ds-action{height:36px;padding:0 14px;background:#2B3036;color:#F6F6F7;border:1px solid #59616C;border-radius:8px;font:13px \"Segoe UI\",sans-serif;cursor:pointer}.ds-action:hover{background:#3B424C}.ds-action:focus-visible{border-color:#9BEF29;outline:none}.ds-action:disabled{opacity:.4}"
    },
    {
      "name": "CLI text field",
      "kind": "input",
      "refersTo": "text-field",
      "description": "Native settings text entry translated for the panel.",
      "html": "<input class=\"ds-field\" aria-label=\"Codex CLI path\" />",
      "css": ".ds-field{padding:9px;background:#252930;color:#F6F6F7;border:1px solid #626A76;caret-color:#9BEF29;font:13px \"Segoe UI\",sans-serif}.ds-field:focus-visible{outline:auto}"
    },
    {
      "name": "Refresh interval select",
      "kind": "input",
      "refersTo": "select",
      "description": "Custom WPF selection surface with lime keyboard focus.",
      "html": "<select class=\"ds-select\" aria-label=\"Refresh interval\"><option>1 minute</option><option>2 minutes</option></select>",
      "css": ".ds-select{height:30px;padding:0 9px;background:#252930;color:#F6F6F7;border:1px solid #626A76;border-radius:6px;font:13px \"Segoe UI\",sans-serif}.ds-select:focus-visible{border-color:#9BEF29;outline:none}.ds-select option{padding:6px 9px;background:#252930;color:#F6F6F7}.ds-select option:checked{background:#414A55}"
    },
    {
      "name": "Consumed quota rings",
      "kind": "custom",
      "description": "Concentric vector tracks with consumed arcs and explicit remaining descriptions.",
      "html": "<svg class=\"ds-rings\" viewBox=\"0 0 220 220\" role=\"img\" aria-label=\"Five-hour quota: 34 percent consumed, 66 percent remaining. Weekly quota: 19 percent consumed, 81 percent remaining.\"><circle cx=\"110\" cy=\"110\" r=\"101\" stroke=\"#3D1E2B\"/><circle cx=\"110\" cy=\"110\" r=\"76\" stroke=\"#263719\"/><circle cx=\"110\" cy=\"110\" r=\"101\" stroke=\"#FF397E\" pathLength=\"100\" stroke-dasharray=\"34 100\" transform=\"rotate(-90 110 110)\"/><circle cx=\"110\" cy=\"110\" r=\"76\" stroke=\"#9BEF29\" pathLength=\"100\" stroke-dasharray=\"19 100\" transform=\"rotate(-90 110 110)\"/></svg>",
      "css": ".ds-rings{width:220px;height:220px}.ds-rings circle{fill:none;stroke-width:18;stroke-linecap:round}"
    }
  ],
  "narrative": {
    "northStar": "Activity-style quota rings",
    "overview": "The user approved an Apple Watch Activity-inspired concept: concentric pink and lime rings on a near-black, rounded floating window. The interface is a glanceable utility. Exact quota semantics matter more than decorative effects. This identity uses native Windows WPF typography, controls and vector rendering.",
    "keyCharacteristics": [
      "Matte dark surface with stable pink and lime window identities.",
      "Consumed quota rings paired with explicit remaining numbers.",
      "Separate full and compact compositions with local reset details.",
      "Native Windows keyboard interaction and accessible quota semantics."
    ],
    "rules": [
      {
        "name": "The Quota Identity Rule",
        "body": "Pink identifies five-hour quota and lime identifies weekly quota in both modes; warning states retain those identities.",
        "section": "colors"
      },
      {
        "name": "The Consumed Ring Rule",
        "body": "Arcs encode consumed quota; prominent row and compact numbers encode remaining quota, with explicit labels and accessible names.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the approved concentric-ring identity across both modes.",
      "Do label absent windows as unavailable; do not invent a zero remaining value.",
      "Do keep dates close to the quota they describe.",
      "Do keep real quota data out of committed preview images.",
      "Do retain visible keyboard focus and read-only accessible quota semantics."
    ],
    "donts": [
      "Don't add an Apple logo, watch hardware frame, extra activity ring or decorative metrics."
    ]
  }
}
