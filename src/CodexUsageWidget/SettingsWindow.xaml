<Window x:Class="CodexUsageWidget.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Настройки · Codex Usage" Width="430" Height="480" ResizeMode="NoResize"
 Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,0,15"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#252930"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#626A76"/><Setter Property="Padding" Value="9"/><Setter Property="CaretBrush" Value="{StaticResource Lime}"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#252930"/>
   <Setter Property="Padding" Value="9,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#414A55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#252930"/>
   <Setter Property="BorderBrush" Value="#626A76"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" BorderBrush="{TemplateBinding BorderBrush}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border Background="#252930" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
        <Path Data="M 0,0 L 5,5 L 10,0" Stroke="#ABB0BA" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
       </Border>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="9,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="#252930" BorderBrush="#626A76" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
       <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Lime}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,22"/>
   <TextBlock Text="Codex CLI" FontWeight="SemiBold" Margin="0,0,0,7"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
    <TextBox x:Name="CodexPathBox" ToolTip="Пустое поле: поиск codex.exe или codex.cmd в PATH" AutomationProperties.Name="Путь к Codex CLI"/>
    <Button Grid.Column="1" Style="{StaticResource ActionButton}" Margin="7,0,0,0" Padding="0" Click="Browse_Click" AutomationProperties.Name="Выбрать Codex CLI" Content="…"/>
   </Grid>
   <TextBlock Text="Оставьте пустым для автоматического поиска." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,18"/>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
    <TextBlock Text="Автообновление" VerticalAlignment="Center"/>
    <ComboBox x:Name="IntervalBox" Grid.Column="1" Height="30" AutomationProperties.Name="Интервал автообновления">
     <ComboBoxItem Content="30 секунд" Tag="30"/><ComboBoxItem Content="1 минута" Tag="60"/>
     <ComboBoxItem Content="2 минуты" Tag="120"/><ComboBoxItem Content="5 минут" Tag="300"/>
    </ComboBox>
   </Grid>
   <CheckBox x:Name="TopmostBox" Content="Поверх остальных окон"/>
   <CheckBox x:Name="StartupBox" Content="Запускать при входе в Windows"/>
   <TextBlock Text="Для лимитов подписки выполните codex login. Данные считываются автоматически; ручное обновление не требуется." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
   <TextBlock x:Name="ErrorText" Foreground="#F1B859" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Отмена" Style="{StaticResource ActionButton}" IsCancel="True" Margin="0,0,8,0"/>
   <Button Content="Сохранить" Style="{StaticResource ActionButton}" IsDefault="True" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
