<loc:WidgetDialogWindow x:Class="CodexUsageWidget.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:CodexUsageWidget"
 xmlns:core="clr-namespace:CodexUsageWidget.Core;assembly=CodexUsageWidget.Core"
 Icon="Assets/app.ico" Title="{loc:Tr Settings}" Width="510" Height="760" ResizeMode="NoResize"
 Language="{Binding CultureName, Source={x:Static core:Localization.Current}, ConverterCulture=en-US}"
 Background="Transparent" Foreground="{StaticResource Text}"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
 <loc:WidgetDialogWindow.Resources>
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,0,0,15"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#252930"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#626A76"/><Setter Property="Padding" Value="9"/><Setter Property="CaretBrush" Value="{StaticResource Lime}"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#252930"/>
   <Setter Property="Padding" Value="9,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#414A55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#252930"/>
   <Setter Property="BorderBrush" Value="#626A76"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" BorderBrush="{TemplateBinding BorderBrush}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border Background="#252930" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
        <Path Data="M 0,0 L 5,5 L 10,0" Stroke="#ABB0BA" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
       </Border>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="9,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="#252930" BorderBrush="#626A76" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
       <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Lime}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </loc:WidgetDialogWindow.Resources>
<Border Background="{StaticResource Surface}" BorderBrush="#353940" BorderThickness="1" CornerRadius="26" Margin="8"><Grid Margin="23">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14"><StackPanel>
      <Grid Margin="0,0,0,22" MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown">
    <TextBlock Text="{loc:Tr Settings}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="DialogClose_Click" ToolTip="{loc:Tr Cancel}" AutomationProperties.Name="{loc:Tr Cancel}"><Path Data="M 3,3 L 15,15 M 15,3 L 3,15" Stroke="{StaticResource Muted}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"/></Button>
   </Grid>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
    <TextBlock Text="{loc:Tr Language}" VerticalAlignment="Center"/>
    <ComboBox x:Name="LanguageBox" Grid.Column="1" Height="32" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectionChanged="Language_Changed" AutomationProperties.Name="{loc:Tr Language}"/>
   </Grid>
   <CheckBox x:Name="AutoUpdatesBox"><TextBlock Text="{loc:Tr AutoUpdates}" TextWrapping="Wrap"/></CheckBox>
   <StackPanel x:Name="UpdatesPanel" Margin="0,0,0,18">
    <TextBlock Text="{loc:Tr Updates}" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock x:Name="UpdateStatus" Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <WrapPanel>
     <Button x:Name="CheckUpdatesButton" Content="{loc:Tr CheckUpdates}" Style="{StaticResource ActionButton}" Height="30" FontSize="11" IsEnabled="{Binding CanCheck}" Click="CheckUpdates_Click" Margin="0,0,8,6"/>
     <Button x:Name="InstallUpdateButton" Content="{loc:Tr InstallUpdate}" Style="{StaticResource ActionButton}" Height="30" FontSize="11" IsEnabled="{Binding CanInstall}" Click="InstallUpdate_Click" ToolTip="{loc:Tr InstallUpdateHint}" Margin="0,0,0,6"/>
    </WrapPanel>
   </StackPanel>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
    <TextBlock Text="{loc:Tr NotificationDuration}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ComboBox x:Name="NotificationDuration" Grid.Column="1" Height="32" MaxDropDownHeight="220" AutomationProperties.Name="{loc:Tr NotificationDuration}"/>
   </Grid>
   <TextBlock Text="Codex CLI" FontWeight="SemiBold" Margin="0,0,0,7"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
    <TextBox x:Name="CodexPathBox" ToolTip="{loc:Tr CliAutoHint}" AutomationProperties.Name="{loc:Tr CliPath}"/>
    <Button Grid.Column="1" Style="{StaticResource ActionButton}" Margin="7,0,0,0" Padding="0" Click="Browse_Click" AutomationProperties.Name="{loc:Tr BrowseCli}" Content="…"/>
   </Grid>
   <TextBlock Text="{loc:Tr CliAutoHint}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,18" TextWrapping="Wrap"/>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
    <TextBlock Text="{loc:Tr AutoRefresh}" VerticalAlignment="Center"/>
    <ComboBox x:Name="IntervalBox" Grid.Column="1" Height="30" AutomationProperties.Name="{loc:Tr RefreshInterval}">
     <ComboBoxItem Content="{loc:Tr Seconds30}" Tag="30"/><ComboBoxItem Content="{loc:Tr Minute1}" Tag="60"/>
     <ComboBoxItem Content="{loc:Tr Minutes2}" Tag="120"/><ComboBoxItem Content="{loc:Tr Minutes5}" Tag="300"/>
    </ComboBox>
   </Grid>
   <Grid Margin="0,0,0,10"><TextBlock Text="{loc:Tr Colors}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="{loc:Tr DefaultColors}" Style="{StaticResource ActionButton}" Height="28" FontSize="11" HorizontalAlignment="Right" Click="DefaultColors_Click"/></Grid>
   <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
    <TextBlock Text="{loc:Tr FiveHours}" VerticalAlignment="Center"/>
    <Button x:Name="FiveHourSwatch" Grid.Column="1" Tag="FiveHourColorBox" Style="{StaticResource ActionButton}" BorderBrush="#626A76" Width="28" Height="28" Padding="0" Click="ColorPalette_Click" ToolTip="{loc:Tr FiveHours}" AutomationProperties.Name="{loc:Tr FiveHours}"/>
    <TextBox x:Name="FiveHourColorBox" Grid.Column="2" TextChanged="Colors_Changed" MaxLength="7" Padding="8,5" AutomationProperties.Name="{loc:Tr FiveHours}"/>
   </Grid>
   <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
    <TextBlock Text="{loc:Tr Weekly}" VerticalAlignment="Center"/>
    <Button x:Name="WeeklySwatch" Grid.Column="1" Tag="WeeklyColorBox" Style="{StaticResource ActionButton}" BorderBrush="#626A76" Width="28" Height="28" Padding="0" Click="ColorPalette_Click" ToolTip="{loc:Tr Weekly}" AutomationProperties.Name="{loc:Tr Weekly}"/>
    <TextBox x:Name="WeeklyColorBox" Grid.Column="2" TextChanged="Colors_Changed" MaxLength="7" Padding="8,5" AutomationProperties.Name="{loc:Tr Weekly}"/>
   </Grid>
   <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
    <TextBlock Text="{loc:Tr Background}" VerticalAlignment="Center"/>
    <Button x:Name="BackgroundSwatch" Grid.Column="1" Tag="BackgroundColorBox" Style="{StaticResource ActionButton}" BorderBrush="#626A76" Width="28" Height="28" Padding="0" Click="ColorPalette_Click" ToolTip="{loc:Tr Background}" AutomationProperties.Name="{loc:Tr Background}"/>
    <TextBox x:Name="BackgroundColorBox" Grid.Column="2" TextChanged="Colors_Changed" MaxLength="7" Padding="8,5" AutomationProperties.Name="{loc:Tr Background}"/>
   </Grid><TextBlock x:Name="ColorError" Foreground="#F1B859" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>
   <CheckBox x:Name="TopmostBox" Content="{loc:Tr AboveWindows}"/>
   <CheckBox x:Name="StartupBox" Content="{loc:Tr StartWindows}"/>

   <TextBlock Text="{loc:Tr LoginHint}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
   <TextBlock x:Name="ErrorText" Foreground="#F1B859" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="{loc:Tr Cancel}" Style="{StaticResource ActionButton}" IsCancel="True" Margin="0,0,8,0"/>
   <Button x:Name="SaveButton" Content="{loc:Tr Save}" Style="{StaticResource ActionButton}" IsDefault="True" Click="Save_Click"/>
  </StackPanel>
 </Grid></Border>
</loc:WidgetDialogWindow>
