<loc:WidgetDialogWindow x:Class="CodexUsageWidget.NoticeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:CodexUsageWidget"
 xmlns:core="clr-namespace:CodexUsageWidget.Core;assembly=CodexUsageWidget.Core"
 Title="Codex Usage Widget" Icon="Assets/app.ico" Width="420" SizeToContent="Height"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
 Language="{Binding CultureName, Source={x:Static core:Localization.Current}, ConverterCulture=en-US}">
 <Border Background="{StaticResource Surface}" BorderBrush="#353940" BorderThickness="1" CornerRadius="26" Margin="8">
  <StackPanel Margin="23">
   <Grid Margin="0,0,0,16" MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown">
    <TextBlock Text="Codex Usage" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="DialogClose_Click" ToolTip="{loc:Tr Cancel}" AutomationProperties.Name="{loc:Tr Cancel}"><Path Data="M 3,3 L 15,15 M 15,3 L 3,15" Stroke="{StaticResource Muted}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"/></Button>
   </Grid>
   <TextBlock Text="{loc:Tr AlreadyRunning}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,22"/>
   <Button Content="OK" HorizontalAlignment="Right" Style="{StaticResource ActionButton}" IsDefault="True" IsCancel="True" Click="DialogClose_Click"/>
  </StackPanel>
 </Border>
</loc:WidgetDialogWindow>
