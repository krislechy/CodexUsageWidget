<Window x:Class="CodexUsageWidget.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:CodexUsageWidget.Controls"
 xmlns:loc="clr-namespace:CodexUsageWidget"
 xmlns:core="clr-namespace:CodexUsageWidget.Core;assembly=CodexUsageWidget.Core"
 Title="Codex Usage Widget" Width="386" Height="598" WindowStyle="None"
 Language="{Binding CultureName, Source={x:Static core:Localization.Current}, ConverterCulture=en-US}"
 AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI Variable, Segoe UI"
 KeyDown="Window_KeyDown" Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.Resources>
  <Geometry x:Key="PinIcon">M 6,1 L 12,1 M 7,1 L 7,6 L 4,10 L 14,10 L 11,6 L 11,1 M 9,10 L 9,17</Geometry>
  <Geometry x:Key="SettingsIcon">M 8,1 L 11,1 L 12,4 L 15,4 L 17,7 L 15,9 L 17,12 L 15,15 L 12,14 L 11,17 L 8,17 L 7,14 L 4,15 L 2,12 L 4,9 L 2,7 L 4,4 L 7,4 Z M 12,9 A 3,3 0 1 1 6,9 A 3,3 0 1 1 12,9</Geometry>
  <Geometry x:Key="CloseIcon">M 3,3 L 15,15 M 15,3 L 3,15</Geometry>
  <Geometry x:Key="RefreshIcon">M 15,7 A 6,6 0 0 0 4,5 M 4,1 L 4,5 L 8,5 M 3,11 A 6,6 0 0 0 14,13 M 14,17 L 14,13 L 10,13</Geometry>
  <Geometry x:Key="CompactIcon">M 4,6 L 9,11 L 14,6</Geometry>
 </Window.Resources>
 <Border x:Name="Surface" Background="{StaticResource Surface}" BorderBrush="#353940" BorderThickness="1" CornerRadius="26" Margin="8"
  MouseLeftButtonDown="Surface_MouseLeftButtonDown">
  <Grid>
   <Grid x:Name="ExpandedPanel" Margin="19,14,19,12" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}">
    <Grid.RowDefinitions>
     <RowDefinition Height="34"/><RowDefinition Height="244"/><RowDefinition Height="74"/><RowDefinition Height="74"/><RowDefinition Height="94"/><RowDefinition Height="32"/>
    </Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
     <TextBlock Text="Codex Usage" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="PinButton" Style="{StaticResource IconButton}" Click="Pin_Click" ToolTip="{loc:Tr AboveWindows}" AutomationProperties.Name="{loc:Tr AboveWindows}">
       <Path Data="{StaticResource PinIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="15" Height="16" Stretch="Uniform"/>
      </Button>
      <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="{loc:Tr Settings}" AutomationProperties.Name="{loc:Tr Settings}">
       <Path Data="{StaticResource SettingsIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform"/>
      </Button>
      <Button Style="{StaticResource IconButton}" Click="Hide_Click" ToolTip="{loc:Tr HideToTray}" AutomationProperties.Name="{loc:Tr HideToTray}">
       <Path Data="{StaticResource CloseIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"/>
      </Button>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0">
     <controls:RingGauge Value="{Binding FiveHourUsed}" RingBrush="{StaticResource Pink}" TrackBrush="#3D1E2B" StrokeWidth="18" AutomationProperties.Name="{Binding FiveHourAccessible}"/>
     <controls:RingGauge Width="170" Height="170" Value="{Binding WeeklyUsed}" RingBrush="{StaticResource Lime}" TrackBrush="#263719" StrokeWidth="18" AutomationProperties.Name="{Binding WeeklyAccessible}"/>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="{loc:Tr Used}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding FiveHourUsedLabel}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding WeeklyUsedLabel}" Foreground="{StaticResource Lime}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="0,6,0,0" AutomationProperties.Name="{Binding FiveHourAccessible}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="21"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition/><RowDefinition Height="1"/></Grid.RowDefinitions>
     <Ellipse Width="12" Height="12" Fill="{StaticResource Pink}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="{loc:Tr FiveHours}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="{Binding FiveHourRemaining}" FontSize="29" FontWeight="Bold"/>
      <TextBlock Text="{loc:Tr Remaining}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="7,4,0,0"/>
     </StackPanel>
     <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FiveHourReset}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FiveHourReset}"/>
     <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#2A2D33"/>
    </Grid>
    <Grid Grid.Row="3" Margin="0,8,0,0" AutomationProperties.Name="{Binding WeeklyAccessible}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="21"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition/><RowDefinition Height="1"/></Grid.RowDefinitions>
     <Ellipse Width="12" Height="12" Fill="{StaticResource Lime}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="{loc:Tr Weekly}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="{Binding WeeklyRemaining}" FontSize="29" FontWeight="Bold"/>
      <TextBlock Text="{loc:Tr Remaining}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="7,4,0,0"/>
     </StackPanel>
     <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding WeeklyReset}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WeeklyReset}"/>
     <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#2A2D33"/>
    </Grid>
    <Grid Grid.Row="4" Margin="0,11,0,0" ToolTip="{Binding ResetDetails}">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="22"/><RowDefinition/><RowDefinition Height="1"/></Grid.RowDefinitions>
     <TextBlock Text="{loc:Tr ResetsHeading}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Button Grid.Column="1" Grid.RowSpan="2" x:Name="ResetButton" Content="{Binding ResetButtonText}" IsEnabled="{Binding CanReset}" Style="{StaticResource ActionButton}" FontSize="12" Padding="11,0" VerticalAlignment="Center" Click="Reset_Click" AutomationProperties.Name="{loc:Tr ResetAction}"/>
     <TextBlock Grid.Row="1" Text="{Binding ResetAvailability}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ResetExpiry}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResetDetails}" VerticalAlignment="Center"/>
     <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#2A2D33"/>
    </Grid>
    <Grid Grid.Row="5" Margin="0,3,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
     <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center">
      <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#83E788"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Fill" Value="#F1B859"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
     </Ellipse>
     <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetails}" AutomationProperties.LiveSetting="Polite"/>
     <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="Compact_Click" ToolTip="{loc:Tr CompactView}" AutomationProperties.Name="{loc:Tr CompactView}">
      <Path Data="{StaticResource CompactIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="13" Height="8" Stretch="Uniform"/>
     </Button>
     <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" ToolTip="{loc:Tr RefreshNow}" AutomationProperties.Name="{loc:Tr RefreshLimits}">
      <Path Data="{StaticResource RefreshIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="15" Height="16" Stretch="Uniform"/>
     </Button>
    </Grid>
   </Grid>
   <Grid x:Name="CompactPanel" Margin="14,10" Visibility="{Binding IsCompact, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding CompactTooltip}" MouseLeftButtonDown="Compact_MouseLeftButtonDown">
    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
    <Grid Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center">
     <controls:RingGauge Value="{Binding FiveHourUsed}" StrokeWidth="5" RingBrush="{StaticResource Pink}" TrackBrush="#3D1E2B" AutomationProperties.Name="{Binding FiveHourAccessible}"/>
     <controls:RingGauge Width="33" Height="33" Value="{Binding WeeklyUsed}" StrokeWidth="5" RingBrush="{StaticResource Lime}" TrackBrush="#263719" AutomationProperties.Name="{Binding WeeklyAccessible}"/>
    </Grid>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.Name="{Binding FiveHourAccessible}">
     <TextBlock Text="{loc:Tr FiveHours}" FontSize="10" Foreground="{StaticResource Pink}"/><TextBlock Text="{Binding FiveHourRemaining}" FontSize="22" FontWeight="Bold"/>
    </StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.Name="{Binding WeeklyAccessible}">
     <TextBlock Text="{loc:Tr Weekly}" FontSize="10" Foreground="{StaticResource Lime}"/><TextBlock Text="{Binding WeeklyRemaining}" FontSize="22" FontWeight="Bold"/>
    </StackPanel>
    <Button Grid.Column="3" Width="22" Style="{StaticResource IconButton}" Click="Compact_Click" ToolTip="{loc:Tr ExpandView}" AutomationProperties.Name="{loc:Tr ExpandView}">
     <Path Data="{StaticResource CompactIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="10" Height="6" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="180"/></Path.RenderTransform></Path>
    </Button>
   </Grid>
  </Grid>
 </Border>
</Window>
